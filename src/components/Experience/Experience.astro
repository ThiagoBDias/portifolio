---
import {
  BriefcaseBusiness,
  ChevronRight,
  Factory,
  ServerCog
} from '@lucide/astro';
import { timeline } from '../../data/timeline';

import './Experience.css';
---

<section class="experience-section" aria-labelledby="experience-title">

  <div class="experience-shell">

    <header class="experience-header">

      <p class="section-label">
        <span></span>
        Experiência aplicada
      </p>

      <h2 id="experience-title">
        Experiência técnica conectada ao negócio.
      </h2>

      <p>
        Minha trajetória passa por suporte de TI, sistemas corporativos
        e operação na mineração. Hoje utilizo essa experiência como base
        para evoluir no desenvolvimento Backend C#/.NET.
      </p>

    </header>

    <ol class="timeline">
      {timeline.map((item, index) => (
        <li class="timeline-item">
          <div class="timeline-marker">
            {index === 0 ? (
              <Factory size={18} strokeWidth={1.8} aria-hidden="true" />
            ) : index === 1 ? (
              <ServerCog size={18} strokeWidth={1.8} aria-hidden="true" />
            ) : (
              <BriefcaseBusiness size={18} strokeWidth={1.8} aria-hidden="true" />
            )}
          </div>

          <article class:list={['timeline-card', { 'timeline-card-current': item.highlight }]}>
            <div class="timeline-meta">
              <span>{item.year}</span>
              <span>{item.company}</span>
            </div>

            <h3>{item.role}</h3>
            <p>{item.description}</p>

            <ul>
              {item.skills.map((skill) => <li>{skill}</li>)}
            </ul>

            {item.highlight && (
              <a href="/contato">
                Vamos conversar
                <ChevronRight size={15} strokeWidth={1.8} aria-hidden="true" />
              </a>
            )}
          </article>
        </li>
      ))}

    </ol>

  </div>

</section>
