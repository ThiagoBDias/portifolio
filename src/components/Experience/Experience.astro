---
import {
  BriefcaseBusiness,
  ChevronRight,
  Factory,
  ServerCog
} from '@lucide/astro';

import './Experience.css';
---

<section class="experience-section" aria-labelledby="experience-title">

  <div class="experience-shell">

    <header class="experience-header">

      <p class="section-label">
        <span></span>
        Experiência aplicada
      </p>

      <h2 id="experience-title">
        Experiência técnica conectada ao negócio.
      </h2>

      <p>
        Minha trajetória passa por suporte de TI, sistemas corporativos
        e operação na mineração. Hoje utilizo essa experiência como base
        para evoluir no desenvolvimento Backend C#/.NET.
      </p>

    </header>

    <ol class="timeline">

      <!-- Operação -->
      <li class="timeline-item">

        <div class="timeline-marker">
          <Factory
            size={18}
            strokeWidth={1.8}
            aria-hidden="true"
          />
        </div>

        <article class="timeline-card">

          <div class="timeline-meta">
            <span>Experiência atual</span>
            <span>Operação e mineração</span>
          </div>

          <h3>
            Controle operacional e informação
          </h3>

          <p>
            Atuação próxima à operação de equipamentos e processos
            da mineração, acompanhando informações utilizadas no
            controle e na tomada de decisão operacional.
          </p>

          <ul>
            <li>Controle operacional</li>
            <li>Equipamentos e processos</li>
            <li>Qualidade da informação</li>
          </ul>

        </article>

      </li>

      <!-- Tecnologia -->
      <li class="timeline-item">

        <div class="timeline-marker">
          <ServerCog
            size={18}
            strokeWidth={1.8}
            aria-hidden="true"
          />
        </div>

        <article class="timeline-card">

          <div class="timeline-meta">
            <span>Experiência em tecnologia</span>
            <span>TI e ERP Sankhya</span>
          </div>

          <h3>
            Suporte, sistemas e regras de negócio
          </h3>

          <p>
            Experiência com suporte de TI e sistemas corporativos,
            incluindo ERP Sankhya, SQL e atendimento às necessidades
            dos usuários e processos da empresa.
          </p>

          <ul>
            <li>ERP Sankhya</li>
            <li>SQL e dados</li>
            <li>Suporte e usuários</li>
          </ul>

        </article>

      </li>

      <!-- Backend -->
      <li class="timeline-item">

        <div class="timeline-marker">
          <BriefcaseBusiness
            size={18}
            strokeWidth={1.8}
            aria-hidden="true"
          />
        </div>

        <article class="timeline-card timeline-card-current">

          <div class="timeline-meta">
            <span>Direcionamento profissional</span>
            <span>Backend C#/.NET</span>
          </div>

          <h3>
            Desenvolvimento Backend
          </h3>

          <p>
            Desenvolvimento de projetos com C#, .NET, APIs REST e SQL,
            aplicando modelagem de dados, separação de responsabilidades
            e boas práticas de desenvolvimento.
          </p>

          <ul>
            <li>C# e .NET</li>
            <li>APIs REST</li>
            <li>SQL</li>
          </ul>

          <a href="/contato">
            Vamos conversar

            <ChevronRight
              size={15}
              strokeWidth={1.8}
              aria-hidden="true"
            />
          </a>

        </article>

      </li>

    </ol>

  </div>

</section>