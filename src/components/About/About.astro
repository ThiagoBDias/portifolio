---
import {
  ArrowUpRight,
  BriefcaseBusiness,
  Code2,
  Database,
  Factory,
  GraduationCap,
  Quote,
  Target
} from '@lucide/astro';

import './About.css';
---

<section class="about-section" aria-labelledby="about-title">

  <div
    class="about-glow about-glow-top"
    aria-hidden="true"
  ></div>

  <div
    class="about-glow about-glow-bottom"
    aria-hidden="true"
  ></div>

  <div class="about-shell">

    <!-- História profissional -->
    <div class="about-story">

      <p class="section-label">
        <span></span>
        Trajetória profissional
      </p>

      <h2 id="about-title">
        Do Operacional<br />
        para o <em>Software</em>
      </h2>

      <p class="about-subtitle">
        Experiência prática de negócio aplicada ao desenvolvimento de software.
      </p>

      <p class="about-intro">
        Minha trajetória combina tecnologia e experiência operacional.
        O contato com processos, dados, equipamentos e sistemas corporativos
        me deu uma visão prática sobre como a informação impacta decisões
        e operações reais. Hoje aplico esse contexto no desenvolvimento
        Backend com C# e .NET.
      </p>

      <blockquote class="problem-quote">

        <Quote
          size={20}
          strokeWidth={1.8}
          aria-hidden="true"
        />

        <p>
          &ldquo;Antes de escrever código, procuro entender o problema,
          as regras e quem depende daquela solução.&rdquo;
        </p>

      </blockquote>

      <!-- Evolução profissional -->
      <div
        class="about-timeline"
        aria-label="Evolução profissional"
      >

        <article class="timeline-entry">

          <span class="timeline-icon">
            <Factory
              size={17}
              strokeWidth={1.8}
              aria-hidden="true"
            />
          </span>

          <div>
            <p>Experiência operacional</p>

            <h3>
              Mineração e controle de operações
            </h3>

            <span>
              Contato direto com equipamentos, apontamentos,
              informações operacionais e processos que dependem
              de dados consistentes.
            </span>
          </div>

        </article>

        <article class="timeline-entry">

          <span class="timeline-icon">
            <Database
              size={17}
              strokeWidth={1.8}
              aria-hidden="true"
            />
          </span>

          <div>
            <p>Sistemas corporativos</p>

            <h3>
              ERP Sankhya e regras de negócio
            </h3>

            <span>
              Experiência com ERP, SQL e processos corporativos,
              conectando necessidades dos usuários aos dados
              utilizados pelo sistema.
            </span>
          </div>

        </article>

        <article class="timeline-entry timeline-entry-current">

          <span class="timeline-icon">
            <Code2
              size={17}
              strokeWidth={1.8}
              aria-hidden="true"
            />
          </span>

          <div>
            <p>Direcionamento atual</p>

            <h3>
              Backend C#/.NET
            </h3>

            <span>
              Desenvolvimento de APIs e projetos backend,
              aplicando separação de responsabilidades,
              modelagem de dados e boas práticas de código.
            </span>
          </div>

        </article>

      </div>

    </div>

    <!-- Perfil -->
    <div
      class="about-profile"
      aria-label="Resumo de formação e especialidades"
    >

      <!-- Formação -->
      <article class="profile-card profile-card-education">

        <span class="profile-icon">
          <GraduationCap
            size={21}
            strokeWidth={1.8}
            aria-hidden="true"
          />
        </span>

        <p class="card-label">
          Formação
        </p>

        <h3>
          Análise e Desenvolvimento de Sistemas
        </h3>

        <p>
          Formação superior em tecnologia com base em desenvolvimento
          de software, banco de dados, análise de sistemas
          e engenharia de software.
        </p>

      </article>

      <!-- Experiência -->
      <article class="profile-card">

        <span class="profile-icon">
          <BriefcaseBusiness
            size={21}
            strokeWidth={1.8}
            aria-hidden="true"
          />
        </span>

        <p class="card-label">
          Experiência
        </p>

        <h3>
          Tecnologia, operação e negócio
        </h3>

        <p>
          Experiência que combina suporte tecnológico,
          sistemas corporativos e conhecimento de processos
          operacionais.
        </p>

      </article>

      <!-- Especialidades -->
      <article class="profile-card profile-card-specialties">

        <span class="profile-icon">
          <Code2
            size={21}
            strokeWidth={1.8}
            aria-hidden="true"
          />
        </span>

        <p class="card-label">
          Foco técnico
        </p>

        <h3>
          Desenvolvimento Backend
        </h3>

        <p>
          C#, .NET, APIs REST e SQL aplicados na construção
          de projetos orientados a regras de negócio.
        </p>

        <div class="tech-badges">
          <span>C#</span>
          <span>.NET</span>
          <span>REST API</span>
          <span>SQL</span>
          <span>Sankhya</span>
        </div>

      </article>

      <!-- Objetivo -->
      <article class="profile-card profile-card-goal">

        <span class="profile-icon">
          <Target
            size={21}
            strokeWidth={1.8}
            aria-hidden="true"
          />
        </span>

        <p class="card-label">
          Objetivo
        </p>

        <h3>
          Backend C#/.NET
        </h3>

        <p>
          Atuar em desenvolvimento backend, evoluindo tecnicamente
          enquanto contribuo para sistemas ligados a problemas
          e processos reais de negócio.
        </p>

        <a href="/contato">
          Conversar sobre oportunidades

          <ArrowUpRight
            size={15}
            strokeWidth={1.8}
            aria-hidden="true"
          />
        </a>

      </article>

    </div>

  </div>

</section>