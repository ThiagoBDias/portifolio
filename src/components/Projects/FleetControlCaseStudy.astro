---
import { ArrowUpRight, Box, CheckCircle2, Code2, Database, Layers3, Route, Server, ShieldCheck } from '@lucide/astro';
import Button from '../ui/Button.astro';
import Card from '../ui/Card.astro';
import Container from '../ui/Container.astro';
import Section from '../ui/Section.astro';
import TechBadge from '../ui/TechBadge.astro';
import './FleetControlCaseStudy.css';

const badges = ['C#', '.NET 8', 'ASP.NET Core', 'Entity Framework', 'SQL Server', 'Docker', 'JWT', 'Swagger', 'REST API', 'Git'];
const features = ['Cadastro de Equipamentos', 'Cadastro de Operadores', 'Controle de Frota', 'Controle de Manutencoes', 'Relatorios', 'Autenticacao'];
const architecture = [
  { name: 'Frontend', detail: 'Interface operacional' },
  { name: 'REST API (.NET)', detail: 'ASP.NET Core' },
  { name: 'Application', detail: 'Casos de uso' },
  { name: 'Domain', detail: 'Regras de negocio' },
  { name: 'Infrastructure', detail: 'Persistencia e integracoes' },
  { name: 'SQL Server', detail: 'Banco de dados' }
];
const challenges = [
  ['Organizacao da arquitetura', 'Separar dominio, aplicacao e infraestrutura para manter regras de negocio independentes do framework.'],
  ['Modelagem do banco', 'Estruturar entidades e relacionamentos para acompanhar veiculos, manutencoes e historico operacional.'],
  ['Autenticacao', 'Aplicar JWT com contratos claros para proteger recursos sem contaminar as regras de dominio.'],
  ['Performance', 'Planejar consultas objetivas, paginacao e acesso a dados com foco em previsibilidade.'],
  ['Escalabilidade', 'Criar limites de responsabilidade que permitam evoluir modulos e integracoes com seguranca.']
];
const learnings = ['Arquitetura em camadas para separar responsabilidades e facilitar evolucoes.', 'Construcao de APIs REST com contratos claros e documentacao via Swagger.', 'Entity Framework e modelagem de banco aplicados ao fluxo operacional.', 'Clean Code e boas praticas para tornar regras de negocio sustentaveis.'];
---

<Section class="fleet-case" aria-labelledby="fleet-case-title">
  <div class="fleet-case-glow" aria-hidden="true"></div>
  <Container class="fleet-case-shell">
    <div class="fleet-case-copy">
      <p class="fleet-kicker"><span></span>Case study · Backend C#/.NET</p>
      <div class="fleet-product"><span><Box size={21} strokeWidth={1.8} /></span>FleetControl API</div>
      <h2 id="fleet-case-title">FleetControl: controle operacional para uma mineradora.</h2>
      <p class="fleet-lead">Uma API para centralizar equipamentos, operadores e operacoes de frota em uma base segura, documentada e preparada para evoluir.</p>

      <div class="fleet-context">
        <Card padding="sm" class="fleet-context-card flex gap-2"><Route size={18} strokeWidth={1.8} /><div><h3>O problema</h3><p>Dados dispersos dificultam organizar equipamentos, operadores e manutencoes, tornando a operacao reativa.</p></div></Card>
        <Card padding="sm" class="fleet-context-card flex gap-2"><Layers3 size={18} strokeWidth={1.8} /><div><h3>A solucao</h3><p>Uma REST API em camadas para registrar, consultar e integrar dados operacionais com consistencia.</p></div></Card>
      </div>

      <div class="fleet-feature-block"><p>Principais funcionalidades</p><ul>{features.map((feature) => <li><CheckCircle2 size={15} strokeWidth={2} />{feature}</li>)}</ul></div>
      <div class="fleet-badges" aria-label="Tecnologias utilizadas">{badges.map((badge) => <TechBadge name={badge} />)}</div>
      <div class="fleet-case-actions"><a class="case-button case-button-secondary" href="https://github.com/ThiagoBDias" target="_blank" rel="noopener noreferrer" data-track="project_github" data-project-name="FleetControl API">GitHub <Code2 size={16} strokeWidth={1.8} /></a><Button variant="primary" size="sm" href="/projetos" class="case-ui-button">Documentacao <ArrowUpRight size={16} strokeWidth={2} /></Button><Button variant="outline" size="sm" href="/projetos" class="case-ui-button">Demo <ArrowUpRight size={16} strokeWidth={2} /></Button></div>
    </div>

    <div class="fleet-case-visual" aria-label="Mockup e arquitetura do FleetControl API">
      <div class="fleet-window">
        <header><div class="fleet-dots" aria-hidden="true"><i></i><i></i><i></i></div><span><Server size={14} strokeWidth={1.8} />fleetcontrol.api</span><em><i></i>healthy</em></header>
        <div class="fleet-window-body"><aside aria-hidden="true"><b>FC</b><i></i><i></i><i></i><i></i></aside><main><div class="fleet-window-title"><div><p>FleetControl</p><small>Operational overview</small></div><span>v1.0.0</span></div><div class="fleet-window-stats"><div><small>Frota ativa</small><strong>248</strong><em>+12 este mes</em></div><div><small>Manutencoes</small><strong>18</strong><em>6 agendadas</em></div></div><div class="fleet-routes"><div><span>API routes</span><small>Swagger</small></div><p><b>GET</b>/api/vehicles <em>200</em></p><p><b class="post">POST</b>/api/maintenance <em>201</em></p><p><b class="put">PUT</b>/api/vehicles/:id <em>204</em></p></div><footer><span><Database size={14} />SQL Server</span><span><ShieldCheck size={14} />JWT secured</span></footer></main></div>
      </div>
      <div class="architecture-flow"><div class="architecture-heading"><Layers3 size={16} strokeWidth={1.8} /><span>Arquitetura utilizada</span></div>{architecture.map((item, index) => <div class="architecture-step"><span class="architecture-node">{index + 1}</span><div><strong>{item.name}</strong><small>{item.detail}</small></div>{index < architecture.length - 1 && <i aria-hidden="true">↓</i>}</div>)}</div>
    </div>
  </Container>

  <Container class="fleet-case-details">
    <Card padding="lg" class="case-detail case-detail-challenges"><p class="fleet-kicker"><span></span>Desafios do projeto</p><h3>Decisoes de engenharia que sustentam a API.</h3><div class="challenge-list">{challenges.map(([title, text], index) => <div><span>0{index + 1}</span><section><h4>{title}</h4><p>{text}</p></section></div>)}</div></Card>
    <Card padding="lg" class="case-detail case-detail-learnings"><p class="fleet-kicker"><span></span>O que aprendi</p><h3>Conhecimento aplicado durante o desenvolvimento.</h3><ul>{learnings.map((learning) => <li><CheckCircle2 size={16} strokeWidth={2} />{learning}</li>)}</ul></Card>
  </Container>
</Section>
