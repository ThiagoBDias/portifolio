---
import {
  ArrowUpRight,
  Box,
  CheckCircle2,
  Code2,
  Database,
  Layers3,
  Route,
  Server,
  ShieldCheck
} from '@lucide/astro';

import Button from '../ui/Button.astro';
import Card from '../ui/Card.astro';
import Container from '../ui/Container.astro';
import Section from '../ui/Section.astro';
import TechBadge from '../ui/TechBadge.astro';

import './FleetControlCaseStudy.css';

/**
 * FleetControl
 *
 * Projeto em desenvolvimento inspirado em processos
 * operacionais reais de mineração.
 *
 * Os itens abaixo representam o escopo e a arquitetura
 * planejados para o projeto.
 */

const badges = [
  'C#',
  '.NET 8',
  'ASP.NET Core',
  'Entity Framework Core',
  'SQL Server',
  'Docker',
  'JWT',
  'Swagger',
  'REST API',
  'Git'
];

const features = [
  'Cadastro de Equipamentos',
  'Cadastro de Operadores',
  'Controle de Frota',
  'Controle de Manutenções',
  'Apontamentos Operacionais',
  'Relatórios',
  'Autenticação'
];

const architecture = [
  {
    name: 'Frontend',
    detail: 'Interface operacional'
  },
  {
    name: 'REST API (.NET)',
    detail: 'ASP.NET Core'
  },
  {
    name: 'Application',
    detail: 'Casos de uso'
  },
  {
    name: 'Domain',
    detail: 'Entidades e regras de negócio'
  },
  {
    name: 'Infrastructure',
    detail: 'Persistência e integrações'
  },
  {
    name: 'SQL Server',
    detail: 'Banco de dados'
  }
];

const challenges = [
  [
    'Modelagem do domínio',
    'Representar equipamentos, operadores, apontamentos, manutenções e demais processos operacionais sem acoplar as regras ao banco ou à interface.'
  ],
  [
    'Modelagem do banco',
    'Estruturar entidades e relacionamentos capazes de preservar o histórico operacional e manter consistência entre os registros.'
  ],
  [
    'Arquitetura da aplicação',
    'Separar domínio, aplicação e infraestrutura para facilitar manutenção, testes e evolução do sistema.'
  ],
  [
    'Autenticação e autorização',
    'Planejar controle de acesso aos recursos da API utilizando autenticação baseada em JWT.'
  ],
  [
    'Consultas e performance',
    'Projetar consultas, filtros e paginação adequados para trabalhar com o crescimento do volume de informações operacionais.'
  ]
];

const learnings = [
  'Modelagem de domínio baseada em processos operacionais reais.',
  'Construção de APIs REST com ASP.NET Core.',
  'Persistência e relacionamentos utilizando Entity Framework Core e SQL Server.',
  'Separação de responsabilidades entre Domain, Application e Infrastructure.',
  'Documentação de endpoints e contratos utilizando Swagger.',
  'Evolução do projeto de requisitos e modelagem até implementação e deploy.'
];
---

<Section
  class="fleet-case"
  aria-labelledby="fleet-case-title"
>
  <div
    class="fleet-case-glow"
    aria-hidden="true"
  ></div>

  <Container class="fleet-case-shell">

    <!-- Conteúdo principal -->
    <div class="fleet-case-copy">

      <p class="fleet-kicker">
        <span></span>
        Case study · Backend C#/.NET · Em desenvolvimento
      </p>

      <div class="fleet-product">
        <span>
          <Box
            size={21}
            strokeWidth={1.8}
            aria-hidden="true"
          />
        </span>

        FleetControl API
      </div>

      <h2 id="fleet-case-title">
        FleetControl: gestão operacional inspirada em processos reais de mineração.
      </h2>

      <p class="fleet-lead">
        Projeto em desenvolvimento para transformar processos de frota,
        equipamentos, operadores e apontamentos em um sistema estruturado,
        utilizando C#/.NET, APIs REST e modelagem de dados.
      </p>

      <!-- Problema e solução -->
      <div class="fleet-context">

        <Card
          padding="sm"
          class="fleet-context-card flex gap-2"
        >
          <Route
            size={18}
            strokeWidth={1.8}
            aria-hidden="true"
          />

          <div>
            <h3>O problema</h3>

            <p>
              Operações de frota geram informações sobre equipamentos,
              operadores, viagens, apontamentos e manutenções. Quando esses
              dados estão dispersos, acompanhar o histórico e transformar
              informação em decisão se torna mais difícil.
            </p>
          </div>
        </Card>

        <Card
          padding="sm"
          class="fleet-context-card flex gap-2"
        >
          <Layers3
            size={18}
            strokeWidth={1.8}
            aria-hidden="true"
          />

          <div>
            <h3>A solução proposta</h3>

            <p>
              Construir uma API backend capaz de centralizar dados
              operacionais, aplicar regras de negócio e servir como base
              para integrações, relatórios e aplicações de gestão.
            </p>
          </div>
        </Card>

      </div>

      <!-- Escopo -->
      <div class="fleet-feature-block">

        <p>Escopo planejado</p>

        <ul>
          {
            features.map((feature) => (
              <li>
                <CheckCircle2
                  size={15}
                  strokeWidth={2}
                  aria-hidden="true"
                />

                {feature}
              </li>
            ))
          }
        </ul>

      </div>

      <!-- Tecnologias -->
      <div
        class="fleet-badges"
        aria-label="Stack planejada para o FleetControl"
      >
        {
          badges.map((badge) => (
            <TechBadge name={badge} />
          ))
        }
      </div>

      <!-- Ações -->
      <div class="fleet-case-actions">

        <a
          class="case-button case-button-secondary"
          href="https://github.com/ThiagoBDias"
          target="_blank"
          rel="noopener noreferrer"
          data-track="project_github"
          data-project-name="FleetControl API"
        >
          Ver perfil no GitHub

          <Code2
            size={16}
            strokeWidth={1.8}
            aria-hidden="true"
          />
        </a>

        <Button
          variant="primary"
          size="sm"
          href="/projetos"
          class="case-ui-button"
        >
          Ver outros projetos

          <ArrowUpRight
            size={16}
            strokeWidth={2}
            aria-hidden="true"
          />
        </Button>

      </div>

    </div>

    <!-- Preview conceitual -->
    <div
      class="fleet-case-visual"
      aria-label="Preview conceitual e arquitetura planejada do FleetControl"
    >

      <div class="fleet-window">

        <header>

          <div
            class="fleet-dots"
            aria-hidden="true"
          >
            <i></i>
            <i></i>
            <i></i>
          </div>

          <span>
            <Server
              size={14}
              strokeWidth={1.8}
              aria-hidden="true"
            />

            fleetcontrol.api
          </span>

          <em>
            <i></i>
            concept
          </em>

        </header>

        <div class="fleet-window-body">

          <aside aria-hidden="true">
            <b>FC</b>
            <i></i>
            <i></i>
            <i></i>
            <i></i>
          </aside>

          <main>

            <div class="fleet-window-title">

              <div>
                <p>FleetControl</p>
                <small>Preview conceitual</small>
              </div>

              <span>Roadmap</span>

            </div>

            <!-- Números ilustrativos do mockup -->
            <div class="fleet-window-stats">

              <div>
                <small>Equipamentos</small>
                <strong>—</strong>
                <em>dados operacionais</em>
              </div>

              <div>
                <small>Manutenções</small>
                <strong>—</strong>
                <em>histórico e controle</em>
              </div>

            </div>

            <!-- Endpoints planejados -->
            <div class="fleet-routes">

              <div>
                <span>API planejada</span>
                <small>REST</small>
              </div>

              <p>
                <b>GET</b>
                /api/equipments
                <em>planned</em>
              </p>

              <p>
                <b class="post">POST</b>
                /api/operators
                <em>planned</em>
              </p>

              <p>
                <b class="put">PUT</b>
                /api/maintenance/:id
                <em>planned</em>
              </p>

            </div>

            <footer>

              <span>
                <Database
                  size={14}
                  aria-hidden="true"
                />

                SQL Server
              </span>

              <span>
                <ShieldCheck
                  size={14}
                  aria-hidden="true"
                />

                JWT planejado
              </span>

            </footer>

          </main>

        </div>

      </div>

      <!-- Arquitetura -->
      <div class="architecture-flow">

        <div class="architecture-heading">

          <Layers3
            size={16}
            strokeWidth={1.8}
            aria-hidden="true"
          />

          <span>
            Arquitetura planejada
          </span>

        </div>

        {
          architecture.map((item, index) => (
            <div class="architecture-step">

              <span class="architecture-node">
                {index + 1}
              </span>

              <div>
                <strong>{item.name}</strong>
                <small>{item.detail}</small>
              </div>

              {
                index < architecture.length - 1 && (
                  <i aria-hidden="true">↓</i>
                )
              }

            </div>
          ))
        }

      </div>

    </div>

  </Container>

  <!-- Detalhes -->
  <Container class="fleet-case-details">

    <!-- Desafios -->
    <Card
      padding="lg"
      class="case-detail case-detail-challenges"
    >

      <p class="fleet-kicker">
        <span></span>
        Decisões de projeto
      </p>

      <h3>
        Desafios técnicos que orientarão a implementação.
      </h3>

      <div class="challenge-list">

        {
          challenges.map(([title, text], index) => (
            <div>

              <span>
                0{index + 1}
              </span>

              <section>
                <h4>{title}</h4>
                <p>{text}</p>
              </section>

            </div>
          ))
        }

      </div>

    </Card>

    <!-- Objetivos técnicos -->
    <Card
      padding="lg"
      class="case-detail case-detail-learnings"
    >

      <p class="fleet-kicker">
        <span></span>
        Objetivos técnicos
      </p>

      <h3>
        Competências que serão desenvolvidas durante o projeto.
      </h3>

      <ul>
        {
          learnings.map((learning) => (
            <li>

              <CheckCircle2
                size={16}
                strokeWidth={2}
                aria-hidden="true"
              />

              {learning}

            </li>
          ))
        }
      </ul>

    </Card>

  </Container>

</Section>
