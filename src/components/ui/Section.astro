---
export interface Props { class?: string; id?: string; spacing?: 'sm' | 'md' | 'lg'; }
const { class: className = '', id, spacing = 'lg' } = Astro.props;
const spacings = { sm: 'py-12', md: 'py-16', lg: 'py-20' };
---
<section id={id} class={`${spacings[spacing]} ${className}`}><slot /></section>
