---
export interface TimelineItem { title: string; description?: string; period?: string; }
export interface Props { items: TimelineItem[]; class?: string; }
const { items, class: className = '' } = Astro.props;
---
<ol class={`relative space-y-6 border-l-2 border-primary-500/50 pl-8 ${className}`}>
  {items.map((item) => <li class="relative"><span class="absolute -left-[2.35rem] top-1 h-4 w-4 rounded-full border-4 border-gray-900 bg-primary-500"></span><p class="font-semibold text-white">{item.title}</p>{item.period && <p class="text-sm text-primary-300">{item.period}</p>}{item.description && <p class="mt-1 text-gray-400">{item.description}</p>}</li>)}
</ol>
