---
export interface Props { name: string; muted?: boolean; class?: string; }
const { name, muted = false, class: className = '' } = Astro.props;
---
<span class={`inline-flex rounded-full border px-3 py-1 text-sm transition-colors duration-200 ${muted ? 'border-gray-600/50 bg-gray-700/50 text-gray-400' : 'border-gray-600/50 bg-gray-700/50 text-gray-300 hover:border-primary-400/50 hover:text-primary-300'} ${className}`}>{name}</span>
